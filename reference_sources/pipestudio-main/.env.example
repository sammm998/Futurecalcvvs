# Anthropic key for the Fable binding stage (vectorascore/llm_bind.py); without it run with --no-llm.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-fable-5-1

# OpenAI key for the Run Astra button (vectorascore/llm_bind.py, provider "astra").
# Without it only Run Fable works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
LLM_EFFORT=medium

REVIEW_KEY=
ADMIN_KEY=
