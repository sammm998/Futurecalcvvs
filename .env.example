# Backend (prefix VVS_)
VVS_DATABASE_URL=sqlite:///./data/vvs.db          # local dev; docker compose uses PostgreSQL
VVS_STORAGE_ROOT=./data/storage
# Nyckeln varje inloggningsbevis undertecknas med. Sätt den till en lång slumpsträng, aldrig till ett ord:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Tjänsten vägrar starta på en driftplattform så länge den står på källkodens standardvärde, för ett bevis
# undertecknat med en publik sträng kan vem som helst skriva om till vilket konto som helst.
VVS_SECRET_KEY=change-me
VVS_ACCESS_TOKEN_MINUTES=1440
VVS_WORKER_THREADS=1
VVS_RUN_DETERMINISM=false                          # true = run 4 extra analyses per job (order-independence proof)
VVS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VVS_ALLOW_REGISTRATION=true
VVS_APP_NAME=VVS Mängdning
# Tidsbudget för en analys. Utan den håller ett enda tätt blad arbetaren för alltid.
VVS_ANALYSIS_DEADLINE_S=1800
# Granskningen efter mätningen: agenter som prövar det färdiga resultatet, och OCR som en oberoende andra
# läsning av bladet. OCR_ASSIST låter OCR namnge de tecken streckigenkännaren inte kunde. Ingen av dem flyttar
# en meter - de läser, de mäter inte.
VVS_RUN_REVIEW=true
VVS_REVIEW_OCR=true
VVS_OCR_ASSIST=true
# Var den byggda webbappen ligger när API:t ska servera den själv (Docker-imagen sätter den till /app/frontend/dist).
# Tom betyder frontend/dist bredvid repot.
VVS_STATIC_DIR=
# Second reader: asks about the cases the geometry itself declared open, among the candidates the drawing offers.
# Leave VVS_SECOND_READER unset and it follows the key - on where OPENAI_API_KEY is present, off where it is not,
# because a service has exactly one use for that key. Set it to true behind a proxy that attaches the credential
# (no key of its own), or to false to keep it off whatever else is configured. It costs a call and a wait per open
# case and turns the determinism check off for that job, which the result then says. Never commit a real key.
# VVS_SECOND_READER=
OPENAI_API_KEY=
VVS_SECOND_READER_MODEL=gpt-6-astra
# Den andra läsaren vid sidan av den första. Är båda konfigurerade avgörs ett öppet fall bara när de väljer
# SAMMA kandidat ur ritningens egen lista; är de oense, eller svarar bara den ena, står fallet kvar tvetydigt.
# Det är avsikten: en ensam modell som gissar fel gör ett ärligt tvetydigt fall till ett självsäkert fel.
ANTHROPIC_API_KEY=
VVS_CLAUDE_MODEL=claude-opus-5
# Vilka läsare som ska användas: auto (de som går att nå), none, eller en lista - astra, claude, "astra,claude".
VVS_SECOND_READERS=auto
